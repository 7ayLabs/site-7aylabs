# Build context for the site image. Anything not needed by `pnpm install`
# or `pnpm build` stays out, so the context is small and no local secret or
# database can end up in a layer.

# Dependencies and build output (rebuilt inside the image)
node_modules
.next
out
dist
build
coverage
*.tsbuildinfo

# Local state and secrets
.env
.env.*
!.env.example
.data
backups
*.db
*.db-wal
*.db-shm
*.pem
*.key
*.log
*.pid

# VCS, editor and tooling
.git
.gitignore
.gitattributes
.github
.gitleaks.toml
.claude
.vscode
.idea
.DS_Store

# Not part of the app bundle
tests
docs
# (root-level Markdown only: patterns without `**/` do not recurse)
*.md
LICENSE
Dockerfile
.dockerignore
docker-compose*.yml
scripts/*.sh

# The update posts are needed at build time and at runtime
!content/**
