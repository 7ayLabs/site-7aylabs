# Copy to .env.local for development. Never commit real values.

# Public address of this deployment (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# production | staging | development. Staging is served with noindex.
NEXT_PUBLIC_SITE_ENV=development

# Where the SQLite file lives. Defaults to ./.data in development.
SITE_DATA_DIR=

# Comma-separated origins allowed to POST to /api/*. Empty = same-origin only checks are skipped (dev).
ALLOWED_ORIGINS=

# Random string; salts the hashed IPs stored with form submissions.
RATE_LIMIT_SALT=

# Optional: signs unsubscribe links. Falls back to RATE_LIMIT_SALT.
SITE_SECRET=

# Optional: email a copy of each contact message through Resend.
RESEND_API_KEY=
CONTACT_NOTIFY_TO=
CONTACT_FROM=

# Set by the image build.
GIT_SHA=
BUILD_TIME=
